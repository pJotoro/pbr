{
	"folders":
	[
		{
			"path": ".",
		},
		{
			"path": "C:\\Odin\\base",
		},
		{
			"path": "C:\\Odin\\core",
		},
		{
			"path": "C:\\Odin\\vendor"
		},
	],
	"build_systems":
	[
		{
			"name": "debug",
			"cmd": "odin build . -debug -out:build/debug/pbr.exe -subsystem:console -target-features:avx2",
			"file_regex":  "^(.+)\\(([0-9]+):([0-9]+)\\) (.+)$",
		},
		{
			"name": "release",
			"cmd": "odin build . -disable-assert -no-bounds-check -no-crt -o:aggressive -out:build/release/pbr.exe -subsystem:windows -target-features:avx2",
			"file_regex":  "^(.+)\\(([0-9]+):([0-9]+)\\) (.+)$",
		}
	],
}
